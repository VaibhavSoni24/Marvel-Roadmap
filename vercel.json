{
  "version": 2,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/support.html",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/pages/support.html",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/supporters.html",
      "destination": "/supporters",
      "permanent": true
    },
    {
      "source": "/pages/supporters.html",
      "destination": "/supporters",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/support",
      "destination": "/pages/support.html"
    },
    {
      "source": "/supporters",
      "destination": "/pages/supporters.html"
    }
  ],
  "headers": [
    {
      "source": "/poster/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
